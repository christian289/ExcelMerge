<UserControl x:Class="ExcelMerge.GUI.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behavior="clr-namespace:ExcelMerge.GUI.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fg="clr-namespace:FastWpfGrid;assembly=FastWpfGrid"
             xmlns:gui="clr-namespace:ExcelMerge.GUI"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:ExcelMerge.GUI.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:props="clr-namespace:ExcelMerge.GUI.Properties"
             xmlns:vc="clr-namespace:ExcelMerge.GUI.ValueConverters"
             d:DesignHeight="1000"
             d:DesignWidth="2000"
             Loaded="UserControl_Loaded"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             mc:Ignorable="d">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="45*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="45*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Expander x:Name="ToolExpander"
                  Grid.Row="0"
                  Grid.Column="0"
                  Grid.ColumnSpan="5"
                  Margin="3">
            <Expander.Header>
                <WrapPanel Margin="3" Orientation="Horizontal">

                    <Button x:Name="DiffButton"
                            Height="32"
                            Margin="5,0,0,0"
                            Padding="3"
                            Click="DiffButton_Click"
                            Content="{x:Static props:Resources.Button_ExtractDiff}"
                            IsEnabled="{Binding Executable}"
                            ToolTip="{x:Static props:Resources.ToolTip_ExtractDiff}" />

                    <Button x:Name="SwapButton"
                            Height="32"
                            Margin="5,0,0,0"
                            Padding="3"
                            Click="SwapButton_Click"
                            Content="{x:Static props:Resources.Button_Swap}"
                            IsEnabled="{Binding Executable}"
                            ToolTip="{x:Static props:Resources.ToolTip_Swap}" />

                    <Button x:Name="PrevSheetButton"
                            Height="32"
                            Margin="5,0,0,0"
                            Padding="3"
                            Click="PrevSheetButton_Click"
                            Content="{x:Static props:Resources.Button_PrevSheet}"
                            IsEnabled="{Binding ExecutablePrev}"
                            ToolTip="{x:Static props:Resources.ToolTip_PrevSheet}" />

                    <Button x:Name="NextSheetButton"
                            Height="32"
                            Margin="5,0,0,0"
                            Padding="3"
                            Click="NextSheetButton_Click"
                            Content="{x:Static props:Resources.Button_NextSheet}"
                            IsEnabled="{Binding ExecutableNext}"
                            ToolTip="{x:Static props:Resources.ToolTip_NextSheet}" />

                    <ComboBox x:Name="SelectedSheetDiffCombobox"
                              Width="25"
                              Height="32"
                              Margin="5,0,0,0"
                              ItemsSource="{Binding SheetDiffInfoList}"
                              SelectionChanged="SelectedSheetDiffCombobox_SelectionChanged">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ComboBoxItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SheetDiff.HasAnyChanges}" Value="True">
                                        <Setter Property="Background" Value="Red" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SheetDiff.HasAnyChanges}" Value="False">
                                        <Setter Property="Background" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <GroupBox Margin="10,0,0,0" Header="{x:Static props:Resources.GroupBox_DisplayFormat}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ShowAllRadioButton"
                                         Margin="3"
                                         Checked="ShowAllRadioButton_Checked"
                                         Content="{x:Static props:Resources.RadioButton_ShowAll}"
                                         IsChecked="True" />
                            <RadioButton x:Name="ShowOnlyDiffRadioButton"
                                         Margin="3"
                                         Checked="ShowOnlyDiffRadioButton_Checked"
                                         Content="{x:Static props:Resources.RadioButton_ShowOnlyDiff}"
                                         IsChecked="False" />
                        </StackPanel>
                    </GroupBox>

                    <!--  Src  -->
                    <GroupBox Margin="10,0,0,0" Header="{x:Static props:Resources.Word_SrcFile}">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{x:Static props:Resources.Word_Path}" />
                            <TextBox x:Name="SrcPathTextBox"
                                     Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={vc:PercentageConverter}, ConverterParameter='0.10'}"
                                     Margin="1"
                                     AcceptsReturn="False"
                                     AllowDrop="True"
                                     Tag="0"
                                     Text="{Binding SrcPath}">
                                <i:Interaction.Behaviors>
                                    <behavior:DragAcceptBehavior Description="{Binding DataContext. Description, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </i:Interaction.Behaviors>
                            </TextBox>
                            <Label Content="{x:Static props:Resources.Word_Sheet}" />
                            <ComboBox x:Name="SrcSheetCombobox"
                                      Width="100"
                                      Margin="0,0,5,0"
                                      ItemsSource="{Binding SrcSheetNames}"
                                      SelectedIndex="{Binding SelectedSrcSheetIndex}" />
                        </StackPanel>
                    </GroupBox>

                    <!--  Dst  -->
                    <GroupBox Margin="10,0,0,0" Header="{x:Static props:Resources.Word_DstFile}">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{x:Static props:Resources.Word_Path}" />
                            <TextBox x:Name="DstPathTextBox"
                                     Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={vc:PercentageConverter}, ConverterParameter='0.10'}"
                                     Margin="1"
                                     AcceptsReturn="False"
                                     AllowDrop="True"
                                     Tag="1"
                                     Text="{Binding DstPath}">
                                <i:Interaction.Behaviors>
                                    <behavior:DragAcceptBehavior Description="{Binding DataContext. Description, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </i:Interaction.Behaviors>
                            </TextBox>
                            <Label Content="{x:Static props:Resources.Word_Sheet}" />
                            <ComboBox x:Name="DstSheetCombobox"
                                      Width="100"
                                      Margin="5,0,0,0"
                                      ItemsSource="{Binding DstSheetNames}"
                                      SelectedIndex="{Binding SelectedDstSheetIndex}" />
                        </StackPanel>
                    </GroupBox>

                    <Grid Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                BorderBrush="Gray"
                                BorderThickness="0.2" />

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               HorizontalAlignment="Center"
                               Content="{Binding ModifiedCellCount}"
                               ContentStringFormat="{x:Static props:Resources.Label_ModifiedCells}" />

                        <Border Grid.Row="0"
                                Grid.Column="0"
                                BorderBrush="Gray"
                                BorderThickness="0.2" />

                        <Label Grid.Row="0"
                               Grid.Column="1"
                               HorizontalAlignment="Center"
                               Content="{Binding ModifiedRowCount}"
                               ContentStringFormat="{x:Static props:Resources.Label_ModifiedRows}" />

                        <Border Grid.Row="0"
                                Grid.Column="1"
                                BorderBrush="Gray"
                                BorderThickness="0.2" />

                        <Label Grid.Row="0"
                               Grid.Column="2"
                               HorizontalAlignment="Center"
                               Content="{Binding AddedRowCount}"
                               ContentStringFormat="{x:Static props:Resources.Label_AddedRows}" />

                        <Border Grid.Row="0"
                                Grid.Column="2"
                                BorderBrush="Gray"
                                BorderThickness="0.2" />

                        <Label Grid.Row="0"
                               Grid.Column="3"
                               HorizontalAlignment="Center"
                               Content="{Binding RemovedRowCount}"
                               ContentStringFormat="{x:Static props:Resources.Label_RemovedRows}" />

                        <Border Grid.Row="0"
                                Grid.Column="3"
                                BorderBrush="Gray"
                                BorderThickness="0.2" />

                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PrevModifiedCellButton"
                                    Grid.Column="0"
                                    Width="30"
                                    Margin="3"
                                    Click="PrevModifiedCellButton_Click"
                                    Content="←"
                                    ToolTip="{x:Static props:Resources.Shortcut_Ctrl_Left}" />
                            <Button x:Name="NextModifiedCellButton"
                                    Grid.Column="1"
                                    Width="30"
                                    Margin="3"
                                    Click="NextModifiedCellButton_Click"
                                    Content="→"
                                    ToolTip="{x:Static props:Resources.Shortcut_Ctrl_Right}" />
                        </Grid>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                BorderBrush="Gray"
                                BorderThickness="0.2" />

                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PrevModifiedRowButton"
                                    Grid.Column="0"
                                    Width="30"
                                    Margin="3"
                                    Click="PrevModifiedRowButton_Click"
                                    Content="←"
                                    ToolTip="{x:Static props:Resources.Shortcut_Ctrl_Up}" />
                            <Button x:Name="NextModifiedRowButton"
                                    Grid.Column="1"
                                    Width="30"
                                    Margin="3"
                                    Click="NextModifiedRowButton_Click"
                                    Content="→"
                                    ToolTip="{x:Static props:Resources.Shortcut_Ctrl_Down}" />
                        </Grid>

                        <Border Grid.Row="1"
                                Grid.Column="1"
                                BorderBrush="Gray"
                                BorderThickness="0.2" />

                        <Grid Grid.Row="1" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PrevAddedRowButton"
                                    Grid.Column="0"
                                    Width="30"
                                    Margin="3"
                                    Click="PrevAddedRowButton_Click"
                                    Content="←"
                                    ToolTip="{x:Static props:Resources.Shortcut_Ctrl_I}" />
                            <Button x:Name="NextAddedRowButton"
                                    Grid.Column="1"
                                    Width="30"
                                    Margin="3"
                                    Click="NextAddedRowButton_Click"
                                    Content="→"
                                    ToolTip="{x:Static props:Resources.Shortcut_Ctrl_K}" />
                        </Grid>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                BorderBrush="Gray"
                                BorderThickness="0.2" />

                        <Grid Grid.Row="1" Grid.Column="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PrevRemovedRowButton"
                                    Grid.Column="0"
                                    Width="30"
                                    Margin="3"
                                    Click="PrevRemovedRowButton_Click"
                                    Content="←"
                                    ToolTip="{x:Static props:Resources.Shortcut_Ctrl_O}" />
                            <Button x:Name="NextRemovedRowButton"
                                    Grid.Column="1"
                                    Width="30"
                                    Margin="3"
                                    Click="NextRemovedRowButton_Click"
                                    Content="→"
                                    ToolTip="{x:Static props:Resources.Shortcut_Ctrl_L}" />
                        </Grid>

                        <Border Grid.Row="1"
                                Grid.Column="3"
                                BorderBrush="Gray"
                                BorderThickness="0.2" />
                    </Grid>

                    <GroupBox Margin="10,0,0,0" Header="키 컬럼 설정">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="UseKeyColumnCheckBox"
                                      Margin="3"
                                      VerticalAlignment="Center"
                                      Content="키 컬럼 사용"
                                      IsChecked="{Binding UseKeyColumn}" />
                            <Label Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Content="키 컬럼명:" />
                            <TextBox x:Name="KeyColumnNamesTextBox"
                                     Width="100"
                                     Margin="3"
                                     VerticalAlignment="Center"
                                     IsEnabled="{Binding UseKeyColumn}"
                                     Text="{Binding KeyColumnNames}"
                                     ToolTip="해당 컬럼명을 입력하세요" />
                        </StackPanel>
                    </GroupBox>
                </WrapPanel>
            </Expander.Header>

            <WrapPanel Margin="3" Orientation="Horizontal">

                <GroupBox Margin="10,0,0,0" Header="{x:Static props:Resources.Word_Search}">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="SearchTextCombobox"
                                  Width="200"
                                  Margin="3"
                                  IsEditable="True" />
                        <CheckBox x:Name="ExactMatchCheckBox"
                                  Margin="3"
                                  Content="{x:Static props:Resources.Word_ExactMatch}"
                                  IsChecked="False" />
                        <CheckBox x:Name="CaseSensitiveCheckBox"
                                  Margin="3"
                                  Content="{x:Static props:Resources.Word_CaseSensitive}"
                                  IsChecked="False" />
                        <CheckBox x:Name="RegexCheckBox"
                                  Margin="3"
                                  Content="{x:Static props:Resources.Word_Regex}"
                                  IsChecked="False" />
                        <Button x:Name="PrevMatchCellButton"
                                Grid.Column="0"
                                Width="30"
                                Margin="3"
                                Click="PrevMatchCellButton_Click"
                                Content="←"
                                ToolTip="{x:Static props:Resources.Shortcut_F8}" />
                        <Button x:Name="NextMatchCellButton"
                                Grid.Column="1"
                                Width="30"
                                Margin="3"
                                Click="NextMatchCellButton_Click"
                                Content="→"
                                ToolTip="{x:Static props:Resources.Shortcut_F9}" />
                    </StackPanel>
                </GroupBox>

                <CheckBox x:Name="IgnoreFileSettingCheckbox"
                          Margin="3"
                          VerticalAlignment="Center"
                          Content="{x:Static props:Resources.Label_IgnoreFileSetting}" />

            </WrapPanel>

        </Expander>

        <!--  Src Location Grid  -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Margin="5,5,5,20"
                BorderBrush="LightGray"
                BorderThickness="1">
            <Grid x:Name="SrcLocationGrid"
                  Background="#00000000"
                  MouseDown="LocationGrid_MouseDown"
                  MouseMove="LocationGrid_MouseMove"
                  MouseWheel="LocationGrid_MouseWheel"
                  ShowGridLines="False">
                <Rectangle x:Name="SrcViewRectangle"
                           Width="{Binding ActualWidth, ElementName=SrcLocationGrid}"
                           Height="{Binding ActualHeight, ElementName=SrcLocationGrid}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Panel.ZIndex="1"
                           Fill="LightBlue"
                           Opacity="0.5" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Grid.Column="0"
                Margin="5,5,5,20"
                SizeChanged="LocationGrid_SizeChanged" />

        <!--  Dst Location Grid  -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="5,5,5,20"
                BorderBrush="LightGray"
                BorderThickness="1">
            <Grid x:Name="DstLocationGrid"
                  Background="#00000000"
                  MouseDown="LocationGrid_MouseDown"
                  MouseMove="LocationGrid_MouseMove"
                  MouseWheel="LocationGrid_MouseWheel"
                  ShowGridLines="False">
                <Rectangle x:Name="DstViewRectangle"
                           Width="{Binding ActualWidth, ElementName=DstLocationGrid}"
                           Height="{Binding ActualHeight, ElementName=DstLocationGrid}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Panel.ZIndex="1"
                           Fill="LightBlue"
                           Opacity="0.5" />
            </Grid>
        </Border>

        <!--  Src Grid  -->
        <fg:FastGridControl x:Name="SrcDataGrid"
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="1,45,1,1"
                            AllowDrop="True"
                            IsReadOnly="True"
                            IsTransposed="{Binding IsChecked, ElementName=chbIsTransposed1, Mode=TwoWay}"
                            RowHeightReserve="0"
                            SelectedCellsChanged="DataGrid_SelectedCellsChanged"
                            SizeChanged="DataGrid_SizeChanged"
                            Tag="0"
                            UseClearType="{Binding IsChecked, ElementName=chbClearType1}">
            <i:Interaction.Behaviors>
                <behavior:DragAcceptBehavior Description="{Binding DataContext. Description, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </i:Interaction.Behaviors>

            <fg:FastGridControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="SetRowHeader_Click" Header="{x:Static props:Resources.ContextMenu_SetRowHeader}" />
                    <MenuItem Click="ResetRowHeader_Click" Header="{x:Static props:Resources.ContextMenu_ResetRowHeader}" />
                    <MenuItem Click="SetColumnHeader_Click" Header="{x:Static props:Resources.ContextMenu_SetColumnHeader}" />
                    <MenuItem Click="ResetColumnHeader_Click" Header="{x:Static props:Resources.ContextMenu_ResetColumnHeader}" />
                    <MenuItem Click="DiffByHeaderSrc_Click" Header="{x:Static props:Resources.ContextMenu_DiffAsHeader}" />
                    <MenuItem Click="BuildCellBaseLog_Click" Header="{x:Static props:Resources.ContextMenu_BuildCellBaseLog}" />
                    <MenuItem Click="CopyAsTsv_Click"
                              Header="{x:Static props:Resources.ContextMenu_CopyAsTsv}"
                              InputGestureText="Ctrl + c" />
                    <MenuItem Click="CopyAsCsv_Click"
                              Header="{x:Static props:Resources.ContextMenu_CopyAsCsv}"
                              InputGestureText="Ctrl + C" />
                </ContextMenu>
            </fg:FastGridControl.ContextMenu>

        </fg:FastGridControl>

        <RichTextBox x:Name="SrcValueTextBox"
                     Grid.Row="1"
                     Grid.Column="2"
                     Height="30"
                     Margin="1"
                     VerticalAlignment="Top"
                     Focusable="True"
                     GotFocus="ValueTextBox_GotFocus"
                     HorizontalScrollBarVisibility="Auto"
                     LostFocus="ValueTextBox_LostFocus"
                     ScrollViewer.ScrollChanged="ValuteTextBox_ScrollChanged"
                     VerticalScrollBarVisibility="Auto" />

        <GridSplitter Grid.Row="2"
                      Grid.Column="3"
                      Width="5"
                      HorizontalAlignment="Center" />

        <!--  Dst Grid  -->
        <fg:FastGridControl x:Name="DstDataGrid"
                            Grid.Row="1"
                            Grid.Column="4"
                            Margin="1,45,1,1"
                            AllowDrop="True"
                            IsReadOnly="True"
                            IsTransposed="{Binding IsChecked, ElementName=chbIsTransposed1, Mode=TwoWay}"
                            RowHeightReserve="0"
                            SelectedCellsChanged="DataGrid_SelectedCellsChanged"
                            SizeChanged="DataGrid_SizeChanged"
                            Tag="1"
                            UseClearType="{Binding IsChecked, ElementName=chbClearType1}">
            <i:Interaction.Behaviors>
                <behavior:DragAcceptBehavior Description="{Binding DataContext. Description, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </i:Interaction.Behaviors>

            <fg:FastGridControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="SetRowHeader_Click" Header="{x:Static props:Resources.ContextMenu_SetRowHeader}" />
                    <MenuItem Click="ResetRowHeader_Click" Header="{x:Static props:Resources.ContextMenu_ResetRowHeader}" />
                    <MenuItem Click="SetColumnHeader_Click" Header="{x:Static props:Resources.ContextMenu_SetColumnHeader}" />
                    <MenuItem Click="ResetColumnHeader_Click" Header="{x:Static props:Resources.ContextMenu_ResetColumnHeader}" />
                    <MenuItem Click="DiffByHeaderDst_Click" Header="{x:Static props:Resources.ContextMenu_DiffAsHeader}" />
                    <MenuItem Click="BuildCellBaseLog_Click" Header="{x:Static props:Resources.ContextMenu_BuildCellBaseLog}" />
                    <MenuItem Click="CopyAsTsv_Click"
                              Header="{x:Static props:Resources.ContextMenu_CopyAsTsv}"
                              InputGestureText="Ctrl + c" />
                    <MenuItem Click="CopyAsCsv_Click"
                              Header="{x:Static props:Resources.ContextMenu_CopyAsCsv}"
                              InputGestureText="Ctrl + C" />
                    <!--<MenuItem Header="{x:Static props:Resources.ContextMenu_BuildRowBaseLog}" Click="BuildRowBaseLog_Click"/>
                    <MenuItem Header="{x:Static props:Resources.ContextMenu_BuildColumnBaseLog}" Click="BuildColumnBaseLog_Click"/>-->
                </ContextMenu>
            </fg:FastGridControl.ContextMenu>

        </fg:FastGridControl>

        <RichTextBox x:Name="DstValueTextBox"
                     Grid.Row="1"
                     Grid.Column="4"
                     Height="30"
                     Margin="1"
                     VerticalAlignment="Top"
                     Focusable="True"
                     GotFocus="ValueTextBox_GotFocus"
                     HorizontalScrollBarVisibility="Auto"
                     LostFocus="ValueTextBox_LostFocus"
                     ScrollViewer.ScrollChanged="ValuteTextBox_ScrollChanged"
                     VerticalScrollBarVisibility="Auto" />

    </Grid>
</UserControl>
