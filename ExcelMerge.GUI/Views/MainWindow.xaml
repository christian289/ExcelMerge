<Window x:Class="ExcelMerge.GUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:ExcelMerge.GUI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ExcelMerge.GUI.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:props="clr-namespace:ExcelMerge.GUI.Properties"
        xmlns:vc="clr-namespace:ExcelMerge.GUI.ValueConverters"
        Title="ExcelMerge"
        Width="{Binding Source={x:Static SystemParameters.PrimaryScreenWidth}, Converter={vc:PercentageConverter}, ConverterParameter='0.8'}"
        Height="{Binding Source={x:Static SystemParameters.PrimaryScreenHeight}, Converter={vc:PercentageConverter}, ConverterParameter='0.8'}"
        Icon="/ExcelMerge.GUI;component/app.ico"
        KeyDown="Window_KeyDown"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        mc:Ignorable="d">

    <Window.Resources>
        <vc:FileDialogParameterConverter x:Key="FileDialogConverter" />
        <vc:CultureNameConverter x:Key="CultureNameConverter" />
    </Window.Resources>

    <Grid x:Name="MainGrid" ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="90*" />
        </Grid.ColumnDefinitions>

        <Menu Grid.Row="0"
              Grid.Column="0"
              Grid.ColumnSpan="2">
            <MenuItem Header="{x:Static props:Resources.Word_File}">
                <MenuItem Command="{Binding OpenFileDialogCommand}" Header="{x:Static props:Resources.MenuItem_OpenSrcFile}">
                    <MenuItem.CommandParameter>
                        <MultiBinding Converter="{StaticResource FileDialogConverter}">
                            <Binding />
                            <Binding Source="SrcPath" />
                        </MultiBinding>
                    </MenuItem.CommandParameter>
                </MenuItem>
                <MenuItem Command="{Binding OpenFileDialogCommand}" Header="{x:Static props:Resources.MenuItem_OpenDstFile}">
                    <MenuItem.CommandParameter>
                        <MultiBinding Converter="{StaticResource FileDialogConverter}">
                            <Binding />
                            <Binding Source="DstPath" />
                        </MultiBinding>
                    </MenuItem.CommandParameter>
                </MenuItem>
                <MenuItem Header="{x:Static props:Resources.MenuItem_RecentFiles}" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemTemplate>
                        <DataTemplate DataType="MenuItem">
                            <Menu>
                                <MenuItem Header="{Binding Path=Header, RelativeSource={RelativeSource AncestorType=MenuItem}}">
                                    <MenuItem Command="{Binding DataContext.OpenAsSrcFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding Path=Header, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                              Header="{x:Static props:Resources.MenuItem_OpenAsSrcFile}" />
                                    <MenuItem Command="{Binding DataContext.OpenAsDstFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding Path=Header, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                              Header="{x:Static props:Resources.MenuItem_OpenAsDstFile}" />
                                </MenuItem>
                            </Menu>
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                </MenuItem>
                <MenuItem Header="{x:Static props:Resources.MenuItem_RecentFileSets}" ItemsSource="{Binding RecentFileSets}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command" Value="{Binding DataContext.OpenFileSetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{x:Static props:Resources.Word_Setting}">
                <MenuItem Command="{Binding OpenDiffExtractionSettingsWindowCommand}" Header="{x:Static props:Resources.MenuItem_GeneralSetting}" />
                <MenuItem Command="{Binding OpenExternalCommandsWindowCommand}" Header="{x:Static props:Resources.MenuItem_ExternalCommands}" />
                <MenuItem Command="{Binding OpenFileSettingsWindowCommand}" Header="{x:Static props:Resources.MenuItem_FileSettings}" />
                <MenuItem Header="{x:Static props:Resources.Word_Language}">
                    <MenuItem Command="{Binding ChangeLanguageCommand}"
                              CommandParameter="en-US"
                              Header="{x:Static props:Resources.Word_English}"
                              IsEnabled="{Binding CultureName, Converter={StaticResource CultureNameConverter}, ConverterParameter='en-US'}" />
                    <MenuItem Command="{Binding ChangeLanguageCommand}"
                              CommandParameter="ja-JP"
                              Header="{x:Static props:Resources.Word_Japanese}"
                              IsEnabled="{Binding CultureName, Converter={StaticResource CultureNameConverter}, ConverterParameter='ja-JP'}" />
                    <MenuItem Command="{Binding ChangeLanguageCommand}"
                              CommandParameter="zh-CN"
                              Header="{x:Static props:Resources.Word_Chinese}"
                              IsEnabled="{Binding CultureName, Converter={StaticResource CultureNameConverter}, ConverterParameter='zh-CN'}" />
                    <MenuItem Command="{Binding ChangeLanguageCommand}"
                              CommandParameter="ko-KR"
                              Header="{x:Static props:Resources.Word_Korean}"
                              IsEnabled="{Binding CultureName, Converter={StaticResource CultureNameConverter}, ConverterParameter='ko-KR'}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{x:Static props:Resources.Word_Tool}">
                <MenuItem Header="{x:Static props:Resources.MenuItem_ExeExternalCmd}" ItemsSource="{Binding ExternalCommands}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command" Value="{Binding DataContext.ExecuteExternalCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                            <EventSetter Event="Loaded" Handler="MenuItem_Loaded" />
                            <Setter Property="IsEnabled" Value="{Binding CanExecute, UpdateSourceTrigger=Explicit}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{x:Static props:Resources.MenuItem_View}">
                <MenuItem x:Name="ConsoleVisibilityMenuItem"
                          Click="ConsoleVisibilityChanged"
                          Header="{x:Static props:Resources.MenuItem_Console}"
                          InputGestureText="Ctrl+D"
                          IsCheckable="True" />
            </MenuItem>
        </Menu>

        <ContentControl Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Content="{Binding Content}" />

        <GridSplitter x:Name="ConsoleGridSplitter"
                      Grid.Row="2"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Width="Auto"
                      Height="5"
                      Margin="0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      Visibility="Collapsed" />

        <ctrl:PowerShellConsole x:Name="Console"
                                Grid.Row="3"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                x:FieldModifier="private"
                                Visibility="Collapsed" />

    </Grid>
</Window>
